{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "isolatedModules": true,
    "jsx": "preserve",
    "tsBuildInfoFile": "./node_modules/.cache/edge-kit.tsbuildinfo"
  },
  "include": ["src/**/*", "cli/**/*"],
  "exclude": ["node_modules", "**/*.test.ts"]
}
